# AbuseIPDB API anahtarınızı buraya yazın.
# Anahtarı https://www.abuseipdb.com/account/api adresinden alabilirsiniz.
ABUSEIPDB_API_KEY=your_api_key_here

# VirusTotal API anahtarı (opsiyonel).
# Anahtarı https://www.virustotal.com/gui/my-apikey adresinden alabilirsiniz.
# Bu alanı boş bırakırsanız uygulama çalışmaya devam eder;
# VirusTotal sütunları "Yapılandırılmadı" olarak gösterilir.
VT_API_KEY=your_virustotal_api_key_here

# AlienVault OTX API anahtarı (opsiyonel).
# Anahtarı https://otx.alienvault.com/api adresinden alabilirsiniz.
# Bu alanı boş bırakırsanız veya silerseniz uygulama çalışmaya devam eder;
# OTX sütunları "Yapılandırılmadı" olarak gösterilir.
OTX_API_KEY=your_otx_api_key_here

# Admin paneli kimlik bilgileri.
# /admin/login sayfasında bu bilgilerle giriş yapılır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Express session şifreleme anahtarı.
# Güvenli ve rastgele bir değer kullanın; boş bırakmayın.
SESSION_SECRET=change_this_secret_key

# Tek bir /check isteğinde sorgulanabilecek maksimum IP sayısı.
MAX_IPS_PER_REQUEST=10

# Rate limiting: aynı ziyaretçinin belirlenen süre içinde gönderebileceği maksimum istek sayısı.
# Yalnızca POST /check endpoint'ine uygulanır; admin panelini etkilemez.
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=20

# Performans logları (varsayılan: false).
# true yapılırsa her /check isteği için AbuseIPDB, OTX ve VirusTotal süreleri terminale yazdırılır.
PERF_LOGS=false

# Backend sunucusunun dinleyeceği port (varsayılan: 3000)
PORT=3000
